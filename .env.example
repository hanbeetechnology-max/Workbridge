# Copy to .env.local for local dev — Vite only exposes vars prefixed VITE_
# to client code. Never commit the real .env.local (already gitignored).
#
# None of these are required to run the app (see scripts/setup-env.js) —
# each integration no-ops gracefully if its var is missing.

# Sentry error monitoring — production only, no-ops if unset.
VITE_SENTRY_DSN=

# PostHog analytics — page views + conversion events, no-ops if unset.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# "Continue with Google" on AuthPage.jsx — the same OAuth Client ID as
# backend/.env's GOOGLE_CLIENT_ID (Google Cloud Console -> Credentials ->
# OAuth 2.0 Client ID -> Web application). Add both your dev origin
# (http://localhost:5173) and your real domain to that client's "Authorized
# JavaScript origins" or Google will reject the request at the popup. If
# unset, AuthPage just doesn't render the Google button — no crash.
VITE_GOOGLE_CLIENT_ID=

# The real backend (backend/src/server.js). Local development default.
# For production, set this in Render to:
# https://workbridge-backend-3lli.onrender.com
VITE_API_URL=http://localhost:4000
